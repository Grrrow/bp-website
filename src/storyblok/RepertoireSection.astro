---
import { storyblokEditable } from '@storyblok/astro'
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro'

const { blok } = Astro.props

const headline = blok.headline || "Repertorio";
const composerGroups = blok.repertoire_composer_group || blok.items || blok.groups || [];
---

<section {...storyblokEditable(blok)} class="repertoire-section reveal reveal-up">
  <div class="container">
    {headline && (
      <div class="section-header">
        <h2 class="section-title">{headline}</h2>
        <div class="title-accent"></div>
      </div>
    )}

    <div class="repertoire-grid">
      {composerGroups.map((subblok: any, index: number) => (
        <div class="reveal reveal-up" style={`--stagger-index: ${index + 1};`}>
          <StoryblokComponent blok={subblok} />
        </div>
      ))}
      
      {composerGroups.length === 0 && (
        <div class="empty-section">
          <span>Añade Composer Groups aquí...</span>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .repertoire-section {
    padding: 6rem 0;
    min-height: 200px;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-header {
    margin-bottom: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: var(--color-on-surface);
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .title-accent {
    width: 60px;
    height: 2px;
    background-color: var(--color-primary);
  }

  .repertoire-grid {
    /* Using Columns for a masonry-like elegant reading flow */
    column-count: 3;
    column-gap: 4rem;
  }
  
  .empty-section {
    min-height: 150px;
    border: 2px dashed rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.5);
    font-family: monospace;
  }

  @media (max-width: 1024px) {
    .repertoire-grid {
      column-count: 2;
      column-gap: 3rem;
    }
  }

  @media (max-width: 640px) {
    .repertoire-section {
      padding: 4rem 0;
    }
    .section-title {
      font-size: 2rem;
    }
    .repertoire-grid {
      column-count: 1;
      column-gap: 0;
    }
  }
</style>
