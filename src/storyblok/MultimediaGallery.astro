---
import { storyblokEditable } from '@storyblok/astro'
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro'

const { blok } = Astro.props

const photoLabel = blok.photo_tab_label || "Fotos"
const videoLabel = blok.video_tab_label || "Videos"

// Fallbacks for the new section arrays in case the names changed
const photosItems = blok.photos_items || blok.sections || blok.photos_sections || blok.items || []
const videoItems = blok.video_items || blok.videos || []

console.log("MULTIMEDIA GALLERY BLOK DATA: ", JSON.stringify(blok, null, 2));
---

<section {...storyblokEditable(blok)} class="multimedia-gallery-section" id="multimedia-gallery">
  <div class="container">
    <nav class="gallery-tabs reveal reveal-up">
      <button class="tab-btn active" data-tab="photos">
        {photoLabel}
        <span class="underline"></span>
      </button>
      <button class="tab-btn" data-tab="videos">
        {videoLabel}
        <span class="underline"></span>
      </button>
    </nav>

    <div class="tabs-content">
      <!-- Photos Grid (Now a list of sections) -->
      <div class="gallery-sections-list active stagger-container" id="photos-grid">
        {photosItems.map((subblok: any, index: number) => (
          <StoryblokComponent blok={subblok} />
        ))}
      </div>

      <!-- Videos Grid -->
      <div class="gallery-grid stagger-container" id="videos-grid">
        {videoItems.map((subblok: any, index: number) => (
          <div class="reveal reveal-up" style={`--stagger-index: ${index + 1};`}>
            <StoryblokComponent blok={subblok} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function initGalleryTabs() {
    const section = document.querySelector('#multimedia-gallery');
    if (!section) return;

    const buttons = section.querySelectorAll('.tab-btn');
    const grids = section.querySelectorAll('.gallery-grid, .gallery-sections-list');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');

        // Update buttons
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // Update grids
        grids.forEach(grid => {
          grid.classList.remove('active');
          if (grid.id === `${targetTab}-grid`) {
            grid.classList.add('active');
          }
        });
      });
    });
  }

  // Initialize on page load and after swaps if using View Transitions
  initGalleryTabs();
  document.addEventListener('astro:after-swap', initGalleryTabs);
</script>

<style>
  .multimedia-gallery-section {
    padding: 4rem 0 10rem 0;
    background-color: var(--color-surface);
    transition: background-color 0.4s ease;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .gallery-tabs {
    display: flex;
    justify-content: center;
    gap: 4rem;
    margin-bottom: 5rem;
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .tab-btn {
    background: none;
    border: none;
    color: var(--color-on-surface);
    opacity: 0.6;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    padding: 1.5rem 0;
    cursor: pointer;
    position: relative;
    transition: color 0.3s ease;
  }

  .tab-btn:hover {
    opacity: 1;
    color: var(--color-on-surface);
  }

  .tab-btn.active {
    opacity: 1;
    color: var(--color-on-surface);
  }

  .underline {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-primary);
    transform: scaleX(0);
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .tab-btn.active .underline {
    transform: scaleX(1);
  }

  .tabs-content {
    position: relative;
    min-height: 400px;
  }

  .gallery-grid, .gallery-sections-list {
    display: none; /* Hidden by default */
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .gallery-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .gallery-sections-list {
    display: none; /* Overridden by .active */
    flex-direction: column;
    gap: 0; /* Gap is handled by individual sections */
  }

  .gallery-grid.active {
    display: grid;
    opacity: 1;
    transform: translateY(0);
  }

  .gallery-sections-list.active {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 1100px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .multimedia-gallery-section {
      padding: 0 0 6rem 0;
    }
    .gallery-tabs {
      gap: 2rem;
      margin-bottom: 3.5rem;
    }
    .tab-btn {
      font-size: 1.125rem;
    }
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
