---
import { storyblokEditable } from '@storyblok/astro'
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro'

const { blok } = Astro.props

const getLabel = (iconType: string) => {
  switch (iconType) {
    case 'user': return 'COMPANY'
    case 'email': return 'GENERAL INQUIRIES'
    case 'phone': return 'PHONE'
    default: return ''
  }
}
---

<div {...storyblokEditable(blok)} class="agency-details-card reveal reveal-up stagger-container">
  <div class="card-header reveal reveal-up" style="--stagger-index: 1;">
    <h2 class="card-title">{blok.title}</h2>
    <div class="accent-dot"></div>
  </div>
  
  <div class="contact-items-list stagger-container">
    {blok.items?.map((item: any, index: number) => {
      const isEmail = item.icon_type === 'email';
      const isPhone = item.icon_type === 'phone';
      const isUser = item.icon_type === 'user';
      
      return (
        <div class="contact-item-group reveal reveal-up" style={`--stagger-index: ${index + 2};`}>
          <div class="item-label-row">
            <div class="icon-box">
              {isUser && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              )}
              {isEmail && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect>
                  <path d="M2 4l10 8 10-8"></path>
                </svg>
              )}
              {isPhone && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              )}
            </div>
            <span class="item-label">{getLabel(item.icon_type)}</span>
          </div>
          <div class="item-content-wrapper">
             <span class="item-value">{item.content}</span>
          </div>
        </div>
      )
    })}
  </div>
</div>

<style>
  .agency-details-card {
    background-color: var(--color-surface-high);
    border-radius: 3rem;
    padding: 5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 4rem;
    height: 100%;
    border: 1px solid var(--color-outline-variant);
    position: relative;
    overflow: hidden;
    transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  /* Interactive lift & glow */
  .agency-details-card:hover {
    transform: translateY(-8px);
    border-color: var(--color-primary);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    background-color: var(--color-surface);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 2.75rem;
    color: var(--color-on-surface);
    font-weight: 300;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .accent-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-primary);
    margin-top: 0.5rem;
  }

  .contact-items-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .contact-item-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 0.3s ease;
  }
  
  .contact-item-group:hover {
    transform: translateX(5px);
  }

  .item-label-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .icon-box {
    width: 18px;
    height: 18px;
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.8;
  }

  .icon-box svg {
    width: 100%;
    height: 100%;
  }

  .item-label {
    font-family: var(--font-body);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-on-surface);
    opacity: 0.5;
    font-weight: 600;
  }

  .item-value {
    font-family: var(--font-body);
    font-size: 1.85rem;
    color: var(--color-on-surface);
    font-weight: 300;
    line-height: 1.1;
    display: block;
    transition: color 0.3s ease;
  }

  .contact-item-group:hover .item-value {
    color: var(--color-primary);
  }

  @media (max-width: 1024px) {
    .agency-details-card {
      padding: 3.5rem 2.5rem;
      border-radius: 2.5rem;
    }
    .card-title {
      font-size: 2.25rem;
    }
  }

  @media (max-width: 768px) {
    .agency-details-card {
      padding: 3rem 2rem;
      gap: 3rem;
    }
    .card-title {
      font-size: 1.85rem;
    }
    .item-value {
      font-size: 1.45rem;
    }
    .contact-items-list {
      gap: 2.5rem;
    }
  }
</style>
