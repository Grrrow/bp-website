---
import { storyblokEditable } from '@storyblok/astro'
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro'

const { blok } = Astro.props

// Flexible field name mapping to handle common Storyblok patterns
const title = blok.title || blok.headline || blok.section_title || blok.tile || ""
const mediaItems = blok.items || blok.photos || blok.gallery_items || blok.media_items || blok.photos_list || []
---

<div {...storyblokEditable(blok)} class="photos-section reveal reveal-up">
  {title && (
    <div class="section-header">
      <h3 class="section-title">{title}</h3>
      <div class="title-accent"></div>
    </div>
  )}

  <div class="section-grid">
    {mediaItems.map((subblok: any, index: number) => (
      <div class="reveal reveal-up" style={`--stagger-index: ${index + 1};`}>
        <StoryblokComponent blok={subblok} />
      </div>
    ))}
  </div>
</div>

<style>
  .photos-section {
    margin-bottom: 6rem;
    min-height: 80px; /* Make the section clickable in Storyblok even without photos */
  }

  .photos-section:last-child {
    margin-bottom: 0;
  }

  .section-header {
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    color: var(--color-on-surface);
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .title-accent {
    width: 40px;
    height: 1px;
    background-color: var(--color-primary);
    opacity: 0.6;
  }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .section-grid:empty {
    min-height: 150px;
    grid-template-columns: 1fr;
    border: 2px dashed rgba(255,255,255,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .section-grid:empty::before {
    content: "Añadir Gallery Items aquí...";
    color: rgba(255,255,255,0.5);
    font-size: 0.9rem;
    font-family: monospace;
  }

  @media (max-width: 1024px) {
    .section-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .section-title {
      font-size: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .section-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .photos-section {
      margin-bottom: 4rem;
    }
    .section-title {
      font-size: 1.25rem;
    }
  }
</style>
